{
  "info": {
    "name": "Locked-in Backend API",
    "description": "Collection Postman variablee pour tester l'API Symfony/API Platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{baseUrl}}"
    },
    {
      "key": "apiPrefix",
      "value": "{{apiPrefix}}"
    },
    {
      "key": "customerEmail",
      "value": "lea.dupont@example.com"
    },
    {
      "key": "customerPassword",
      "value": "customer1234"
    },
    {
      "key": "registerEmail",
      "value": "new.customer@example.com"
    },
    {
      "key": "registerPassword",
      "value": "customer1234"
    },
    {
      "key": "registerFirstname",
      "value": "Nina"
    },
    {
      "key": "registerLastname",
      "value": "Roux"
    },
    {
      "key": "registerBirthDate",
      "value": "1997-05-12"
    },
    {
      "key": "addressId",
      "value": "1"
    },
    {
      "key": "companyId",
      "value": "1"
    },
    {
      "key": "specificationId",
      "value": "1"
    },
    {
      "key": "lockerBayId",
      "value": "1"
    },
    {
      "key": "lockerId",
      "value": "1"
    },
    {
      "key": "customerId",
      "value": "1"
    },
    {
      "key": "reservationId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "API Docs",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}{{apiPrefix}}"
      }
    },
    {
      "name": "GET Endpoints",
      "item": [
        {
          "name": "Get addresses",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/addresses"
          }
        },
        {
          "name": "Get address by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/addresses/{{addressId}}"
          }
        },
        {
          "name": "Get companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/companies"
          }
        },
        {
          "name": "Get specifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/specifications"
          }
        },
        {
          "name": "Get locker bays",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/locker_bays"
          }
        },
        {
          "name": "Get locker bay by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/locker_bays/{{lockerBayId}}"
          }
        },
        {
          "name": "Get lockers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/lockers"
          }
        },
        {
          "name": "Get lockers by locker bay",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/lockers?lockerBay={{apiPrefix}}/locker_bays/{{lockerBayId}}"
          }
        },
        {
          "name": "Get locker by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/lockers/{{lockerId}}"
          }
        },
        {
          "name": "Get customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/customers"
          }
        },
        {
          "name": "Get my customer profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/customers/me"
          }
        },
        {
          "name": "Get reservations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/reservations"
          }
        },
        {
          "name": "Get locker actions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/locker_actions"
          }
        },
        {
          "name": "Get locker events",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/locker_events"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Customer register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\",\n  \"firstname\": \"{{registerFirstname}}\",\n  \"lastname\": \"{{registerLastname}}\",\n  \"birthDate\": \"{{registerBirthDate}}\",\n  \"address\": \"{{apiPrefix}}/addresses/{{addressId}}\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration success', function () {",
                  "  pm.response.to.have.status(201);",
                  "  var data = pm.response.json();",
                  "  pm.expect(data).to.have.property('token');",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json && json.token) {",
                  "  pm.environment.set('bearerToken', json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer login (JWT)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWT token present', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var data = pm.response.json();",
                  "  pm.expect(data).to.have.property('token');",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json && json.token) {",
                  "  pm.environment.set('bearerToken', json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my customer profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/merge-patch+json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Client\",\n  \"lastname\": \"Mobile\",\n  \"email\": \"{{customerEmail}}\",\n  \"birthDate\": \"1997-05-12T00:00:00+00:00\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/customers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer profile updated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var data = pm.response.json();",
                  "  pm.expect(data).to.have.property('email');",
                  "  pm.expect(data).to.have.property('firstname');",
                  "  pm.expect(data).to.have.property('lastname');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Addresses",
      "item": [
        {
          "name": "List addresses",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/addresses"
          }
        },
        {
          "name": "Create address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"18B\",\n  \"city\": \"Lyon\",\n  \"country\": \"France\",\n  \"street\": \"Rue de la Republique\",\n  \"complement\": \"Batiment C\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/addresses"
          }
        }
      ]
    },
    {
      "name": "Core",
      "item": [
        {
          "name": "Create company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Open Innov 2\",\n  \"siret\": \"22345678901234\",\n  \"siren\": \"223456789\",\n  \"ape\": \"6201Z\",\n  \"address\": \"{{apiPrefix}}/addresses/{{addressId}}\",\n  \"juridicForm\": \"SAS\",\n  \"phone\": \"+33478000000\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/companies"
          }
        },
        {
          "name": "Create specification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"width\": 35,\n  \"height\": 25,\n  \"depth\": 45,\n  \"material\": \"Steel\",\n  \"name\": \"S+\",\n  \"isRechargeable\": true\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/specifications"
          }
        },
        {
          "name": "Create locker bay",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lyon Bellecour\",\n  \"latitude\": \"45.7578137\",\n  \"longitude\": \"4.8320114\",\n  \"company\": \"{{apiPrefix}}/companies/{{companyId}}\",\n  \"maxDuration\": 1440,\n  \"minDuration\": 30\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/locker_bays"
          }
        },
        {
          "name": "Create locker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": 10,\n  \"hardwareId\": \"LOCK-LYON-BEL-010\",\n  \"specification\": \"{{apiPrefix}}/specifications/{{specificationId}}\",\n  \"priceCents\": 400,\n  \"lockerBay\": \"{{apiPrefix}}/locker_bays/{{lockerBayId}}\",\n  \"status\": \"available\",\n  \"lastSeenAt\": \"2026-03-03T10:00:00+00:00\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/lockers"
          }
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sam.dupuis@example.com\",\n  \"roles\": [\n    \"ROLE_CUSTOMER\"\n  ],\n  \"password\": \"customer1234\",\n  \"firstname\": \"Sam\",\n  \"lastname\": \"Dupuis\",\n  \"birthDate\": \"1998-06-15T00:00:00+00:00\",\n  \"address\": \"{{apiPrefix}}/addresses/{{addressId}}\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/customers"
          }
        }
      ]
    },
    {
      "name": "Reservation Flow",
      "item": [
        {
          "name": "Create reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startsAt\": \"2026-03-04T09:00:00+00:00\",\n  \"endsAt\": \"2026-03-04T11:00:00+00:00\",\n  \"locker\": \"{{apiPrefix}}/lockers/{{lockerId}}\",\n  \"status\": \"confirmed\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/reservations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reservation created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  var data = pm.response.json();",
                  "  pm.expect(data).to.have.property('id');",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.environment.set('reservationId', String(json.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create locker action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locker\": \"{{apiPrefix}}/lockers/{{lockerId}}\",\n  \"type\": \"open\",\n  \"status\": \"pending\",\n  \"reservation\": \"{{apiPrefix}}/reservations/{{reservationId}}\",\n  \"requestedByCustomer\": \"{{apiPrefix}}/customers/{{customerId}}\",\n  \"requestedAt\": \"2026-03-03T10:30:00+00:00\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/locker_actions"
          }
        },
        {
          "name": "Create locker event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locker\": \"{{apiPrefix}}/lockers/{{lockerId}}\",\n  \"reservation\": \"{{apiPrefix}}/reservations/{{reservationId}}\",\n  \"type\": \"door_opened\",\n  \"payload\": {\n    \"source\": \"mobile_app\",\n    \"battery\": 91\n  },\n  \"occurredAt\": \"2026-03-03T10:31:00+00:00\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/locker_events"
          }
        }
      ]
    }
  ]
}
