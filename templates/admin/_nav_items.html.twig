{% import "macros/fontawesome.html.twig" as fa %}
{% set currentRoute = app.request.attributes.get('_route') %}

<div class="admin-nav-section">
    <p class="admin-nav-title">Exploitation</p>

    <a
        href="{{ path('app_admin_dashboard') }}"
        class="admin-nav-link {{ currentRoute starts with 'app_admin_dashboard' ? 'is-active' : '' }}"
    >
        <span>{{ fa.icon(name: 'chart-line', family: 'solid', size: 'md', additional_classes: ['me-2']) }}Tableau de bord</span>
    </a>

    <a
        href="{{ path('app_admin_locker_bays_index') }}"
        class="admin-nav-link {{ currentRoute starts with 'app_admin_locker_bays' or currentRoute starts with 'app_admin_lockers' ? 'is-active' : '' }}"
    >
        <span>{{ fa.icon(name: 'unlock', family: 'solid', size: 'md', additional_classes: ['me-2']) }}Casiers</span>
    </a>

    <a
        href="{{ path('app_admin_customers_index') }}"
        class="admin-nav-link {{ currentRoute starts with 'app_admin_customers' ? 'is-active' : '' }}"
    >
        <span>{{ fa.icon(name: 'circle-user', family: 'solid', size: 'md', additional_classes: ['me-2']) }}Clients</span>
    </a>
</div>

{% if is_granted('ROLE_ADMIN') %}
    <div class="admin-nav-section">
        <p class="admin-nav-title">Administration</p>

        <a
            href="{{ path('app_admin_companies_index') }}"
            class="admin-nav-link {{ currentRoute starts with 'app_admin_companies' ? 'is-active' : '' }}"
        >
            <span>{{ fa.icon(name: 'building', family: 'solid', size: 'md', additional_classes: ['me-2']) }}Societes</span>
        </a>

        <a
            href="{{ path('app_admin_users_index') }}"
            class="admin-nav-link {{ currentRoute starts with 'app_admin_users' ? 'is-active' : '' }}"
        >
            <span>{{ fa.icon(name: 'user', family: 'solid', size: 'md', additional_classes: ['me-2']) }}Utilisateurs BO</span>
        </a>
    </div>
{% endif %}

<div class="admin-nav-section">
    <p class="admin-nav-title">Ressources</p>

    <a
        href="/api"
        class="admin-nav-link"
        target="_blank"
        rel="noreferrer"
    >
        <span>{{ fa.icon(name: 'code', family: 'solid', size: 'md', additional_classes: ['me-2']) }}API Docs</span>
    </a>
</div>

<div class="admin-nav-mobile-footer d-lg-none p-3 border-top">
    <a href="{{ path('app_admin_logout') }}" class="btn btn-outline-danger w-100 btn-sm">Se deconnecter</a>
</div>
