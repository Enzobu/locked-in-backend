{% extends 'admin/layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block admin_content %}
    <section class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
        <div>
            <h2 class="h3 mb-1">{{ title }}</h2>
            <p class="text-body-secondary mb-0">Baie: {{ lockerBay.name }} ({{ lockerBay.company.name }})</p>
        </div>
        <a href="{{ path('app_admin_locker_bays_show', {id: lockerBay.id}) }}" class="btn btn-outline-secondary">Retour baie</a>
    </section>

    <article class="card shadow-sm">
        <div class="card-body">
            {{ form_start(form) }}
            <div class="row g-3">
                <div class="col-12 col-md-4">{{ form_row(form.number) }}</div>
                <div class="col-12 col-md-8">{{ form_row(form.hardwareId) }}</div>
                <div class="col-12 col-md-6">{{ form_row(form.specification) }}</div>
                <div class="col-12 col-md-6">{{ form_row(form.priceCents) }}</div>
                <div class="col-12 col-md-6">{{ form_row(form.status) }}</div>
                <div class="col-12 col-md-6">{{ form_row(form.lastSeenAt) }}</div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" type="submit">{{ submitLabel }}</button>
                <a href="{{ path('app_admin_locker_bays_show', {id: lockerBay.id}) }}" class="btn btn-outline-secondary">Annuler</a>
            </div>
            {{ form_end(form) }}
        </div>
    </article>
{% endblock %}
