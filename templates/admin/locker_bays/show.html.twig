{% extends 'admin/layout.html.twig' %}
{% import 'macros/badge.html.twig' as label %}

{% block title %}Baie {{ bay.name }}{% endblock %}

{% block admin_content %}
    {% set total = bay.lockers|length %}
    {% set available = 0 %}
    {% set reserved = 0 %}
    {% set occupied = 0 %}
    {% set offline = 0 %}
    {% set outOfOrder = 0 %}

    {% for locker in bay.lockers %}
        {% if locker.status.value == 'available' %}{% set available = available + 1 %}{% endif %}
        {% if locker.status.value == 'reserved' %}{% set reserved = reserved + 1 %}{% endif %}
        {% if locker.status.value == 'occupied' %}{% set occupied = occupied + 1 %}{% endif %}
        {% if locker.status.value == 'offline' %}{% set offline = offline + 1 %}{% endif %}
        {% if locker.status.value == 'out_of_order' %}{% set outOfOrder = outOfOrder + 1 %}{% endif %}
    {% endfor %}

    <section class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
        <div>
            <a class="link-secondary text-decoration-none" href="{{ path('app_admin_locker_bays_index') }}">← Retour aux baies</a>
            <h2 class="h3 mt-2 mb-1">{{ bay.name }}</h2>
            <p class="text-body-secondary mb-0">{{ bay.company.name }}</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge text-bg-secondary" style="margin-top: auto; margin-bottom: auto;">{{ lockers|length ~ ' casier(s) affiches' }}</span>
            {% if is_granted('ROLE_ADMIN') %}
                <a class="btn btn-outline-primary" href="{{ path('app_admin_companies_locker_bays_edit', {id: bay.id}) }}">Modifier baie</a>
                <a class="btn btn-primary" href="{{ path('app_admin_companies_lockers_new', {id: bay.id}) }}">Ajouter casier</a>
            {% endif %}
        </div>
    </section>

    <section class="row g-3 mb-4">
        <div class="col-12 col-xl-4">
            <article class="card shadow-sm h-100">
                <div class="card-header bg-transparent"><h3 class="h6 mb-0">Caracteristiques baie</h3></div>
                <div class="card-body small">
                    <p class="mb-2"><strong>Coordonnees:</strong> {{ bay.latitude }}, {{ bay.longitude }}</p>
                    <p class="mb-2"><strong>Duree min:</strong> {{ bay.minDuration ?? '-' }} min</p>
                    <p class="mb-2"><strong>Duree max:</strong> {{ bay.maxDuration ?? '-' }} min</p>
                    <p class="mb-0"><strong>Mise a jour:</strong> {{ bay.updatedAt|date('d/m/Y H:i') }}</p>
                </div>
            </article>
        </div>
        <div class="col-12 col-xl-8">
            <article class="card shadow-sm h-100">
                <div class="card-header bg-transparent"><h3 class="h6 mb-0">Mini dashboard fonctionnement</h3></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6 col-lg-4">{{ label.emphasis(total ~ ' total', 'primary') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(available ~ ' disponibles', 'success') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(reserved ~ ' reserves', 'primary') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(occupied ~ ' occupes', 'warning') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(offline ~ ' offline', 'danger') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(outOfOrder ~ ' HS', 'dark') }}</div>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <form class="row g-2 mb-3" method="get">
        <div class="col-12 col-md-5">
            <input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Rechercher numero ou hardware ID">
        </div>
        <div class="col-12 col-md-3">
            <select name="status" class="form-select">
                <option value="all" {{ statusFilter == 'all' ? 'selected' : '' }}>Tous statuts</option>
                <option value="available" {{ statusFilter == 'available' ? 'selected' : '' }}>Disponible</option>
                <option value="reserved" {{ statusFilter == 'reserved' ? 'selected' : '' }}>Reserve</option>
                <option value="occupied" {{ statusFilter == 'occupied' ? 'selected' : '' }}>Occupe</option>
                <option value="offline" {{ statusFilter == 'offline' ? 'selected' : '' }}>Offline</option>
                <option value="out_of_order" {{ statusFilter == 'out_of_order' ? 'selected' : '' }}>Hors service</option>
            </select>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary" type="submit">Filtrer</button>
        </div>
    </form>

    <section class="row g-3">
        {% for locker in lockers %}
            <div class="col-12 col-md-6 col-xl-4">
                <article class="card shadow-sm h-100 locker-card locker-status-{{ locker.status.value }}">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                            <h3 class="h5 mb-0">Casier #{{ locker.number }}</h3>
                            {% set status = locker.status.value %}
                            {% if status == 'available' %}
                                {{ label.default('Disponible', 'success') }}
                            {% elseif status == 'reserved' %}
                                {{ label.default('Reserve') }}
                            {% elseif status == 'occupied' %}
                                {{ label.default('Occupe', 'warning') }}
                            {% elseif status == 'offline' %}
                                {{ label.default('Offline', 'danger') }}
                            {% else %}
                                {{ label.default('Hors service', 'dark') }}
                            {% endif %}
                        </div>
                        <p class="small text-body-secondary mb-1">Hardware: {{ locker.hardwareId ?? '-' }}</p>
                        <p class="small text-body-secondary mb-1">Prix: {{ (locker.priceCents / 100)|number_format(2, ',', ' ') }} EUR</p>
                        <p class="small text-body-secondary mb-0">Derniere vue: {{ locker.lastSeenAt ? locker.lastSeenAt|date('d/m/Y H:i') : '-' }}</p>
                        <div class="mt-3 d-flex gap-2 flex-wrap">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_lockers_show', {id: locker.id}) }}">Voir</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_companies_lockers_edit', {id: locker.id}) }}">Modifier</a>
                                <form method="post" action="{{ path('app_admin_companies_lockers_delete', {id: locker.id}) }}" onsubmit="return confirm('Supprimer ce casier ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_locker_' ~ locker.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </article>
            </div>
        {% else %}
            <div class="col-12">
                <div class="card shadow-sm"><div class="card-body text-body-secondary">Aucun casier correspondant a votre filtre.</div></div>
            </div>
        {% endfor %}
    </section>
{% endblock %}
