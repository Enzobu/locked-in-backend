{% extends 'admin/layout.html.twig' %}
{% import 'macros/badge.html.twig' as label %}
{% import 'macros/modal.html.twig' as modal %}

    {% block title %}Baie {{ bay.name }}{% endblock %}

{% block admin_content %}
    {% set total = bay.lockers|length %}
    {% set available = 0 %}
    {% set reserved = 0 %}
    {% set occupied = 0 %}
    {% set offline = 0 %}
    {% set outOfOrder = 0 %}

    {% for locker in bay.lockers %}
        {% if locker.status.value == 'available' %}{% set available = available + 1 %}{% endif %}
        {% if locker.status.value == 'reserved' %}{% set reserved = reserved + 1 %}{% endif %}
        {% if locker.status.value == 'occupied' %}{% set occupied = occupied + 1 %}{% endif %}
        {% if locker.status.value == 'offline' %}{% set offline = offline + 1 %}{% endif %}
        {% if locker.status.value == 'out_of_order' %}{% set outOfOrder = outOfOrder + 1 %}{% endif %}
    {% endfor %}

    <section class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
        <div>
            <a class="link-secondary text-decoration-none" href="{{ path('app_admin_locker_bays_index') }}">← Retour aux baies</a>
            <h2 class="h3 mt-2 mb-1">{{ bay.name }}</h2>
            <p class="text-body-secondary mb-0">{{ bay.company.name }}</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge text-bg-secondary" style="margin-top: auto; margin-bottom: auto;">{{ lockers|length ~ ' casier(s) affichés' }}</span>
            {% if not is_granted('ROLE_ADMIN') %}
            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#durationsModal">Modifier les durées</button>
            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#overtimeSurchargeModal">Modifier la majoration</button>
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
                <a class="btn btn-outline-primary" href="{{ path('app_admin_companies_locker_bays_edit', {id: bay.id}) }}">Modifier baie</a>
                <a class="btn btn-primary" href="{{ path('app_admin_companies_lockers_new', {id: bay.id}) }}">Ajouter casier</a>
            {% endif %}
        </div>
    </section>

    <section class="row g-3 mb-4">
        <div class="col-12 col-xl-4">
            <article class="card shadow-sm h-100">
                <div class="card-header bg-transparent"><h3 class="h6 mb-0">Caractéristiques baie</h3></div>
                <div class="card-body small">
                    <p class="mb-2"><strong>Coordonnées:</strong> {{ bay.latitude }}, {{ bay.longitude }}</p>
                    <p class="mb-2"><strong>Durée min:</strong> {{ bay.minDuration ?? '-' }} min</p>
                    <p class="mb-2"><strong>Durée max:</strong> {{ bay.maxDuration ?? '-' }} min</p>
                    <p class="mb-2"><strong>Majoration dépassement:</strong> {{ bay.overtimeSurchargePercent }} %</p>
                    <p class="mb-0"><strong>Mise à jour:</strong> {{ bay.updatedAt|date('d/m/Y H:i') }}</p>
                </div>
            </article>
        </div>
        <div class="col-12 col-xl-8">
            <article class="card shadow-sm h-100">
                <div class="card-header bg-transparent"><h3 class="h6 mb-0">Mini dashboard fonctionnement</h3></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6 col-lg-4">{{ label.emphasis(total ~ ' total', 'primary') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(available ~ ' disponibles', 'success') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(reserved ~ ' réservés', 'primary') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(occupied ~ ' occupés', 'warning') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(offline ~ ' offline', 'danger') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(outOfOrder ~ ' HS', 'dark') }}</div>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <form class="row g-2 mb-3" method="get">
        <div class="col-12 col-md-5">
            <input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Rechercher numéro ou hardware ID">
        </div>
        <div class="col-12 col-md-3">
            <select name="status" class="form-select">
                <option value="all" {{ statusFilter == 'all' ? 'selected' : '' }}>Tous statuts</option>
                <option value="available" {{ statusFilter == 'available' ? 'selected' : '' }}>Disponible</option>
                <option value="reserved" {{ statusFilter == 'reserved' ? 'selected' : '' }}>Réservé</option>
                <option value="occupied" {{ statusFilter == 'occupied' ? 'selected' : '' }}>Occupé</option>
                <option value="offline" {{ statusFilter == 'offline' ? 'selected' : '' }}>Offline</option>
                <option value="out_of_order" {{ statusFilter == 'out_of_order' ? 'selected' : '' }}>Hors service</option>
            </select>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary" type="submit">Filtrer</button>
        </div>
    </form>

    <section class="row g-3">
        {% for locker in lockers %}
            <div class="col-12 col-md-6 col-xl-4">
                <article class="card shadow-sm h-100 locker-card locker-status-{{ locker.status.value }}">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                            <h3 class="h5 mb-0">Casier #{{ locker.number }}</h3>
                            {% set status = locker.status.value %}
                            {% if status == 'available' %}
                                {{ label.default('Disponible', 'success') }}
                            {% elseif status == 'reserved' %}
                                {{ label.default('Réservé') }}
                            {% elseif status == 'occupied' %}
                                {{ label.default('Occupé', 'warning') }}
                            {% elseif status == 'offline' %}
                                    {{ label.default('Offline', 'danger') }}
                            {% else %}
                                {{ label.default('Hors service', 'dark') }}
                            {% endif %}
                        </div>
                        <p class="small text-body-secondary mb-1">Hardware: {{ locker.hardwareId ?? '-' }}</p>
                        <p class="small text-body-secondary mb-1">Prix: {{ (locker.priceCents / 100)|number_format(2, ',', ' ') }} EUR</p>
                        <p class="small text-body-secondary mb-0">Dernière vue: {{ locker.lastSeenAt ? locker.lastSeenAt|date('d/m/Y H:i') : '-' }}</p>
                        <div class="mt-3 d-flex gap-2 flex-wrap">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_lockers_show', {id: locker.id}) }}">Voir</a>
                            {% if not is_granted('ROLE_ADMIN') %}
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#lockerPriceModal{{ locker.id }}">Modifier prix</button>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_companies_lockers_edit', {id: locker.id}) }}">Modifier</a>
                                <form id="deleteLockerForm{{ locker.id }}" method="post" action="{{ path('app_admin_companies_lockers_delete', {id: locker.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_locker_' ~ locker.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteLockerModal{{ locker.id }}">Supprimer</button>
                                </form>
                                {{ modal.confirm('deleteLockerModal' ~ locker.id, 'Supprimer un casier', 'Voulez-vous vraiment supprimer ce casier ?', 'deleteLockerForm' ~ locker.id, 'Supprimer', 'danger') }}
                            {% endif %}
                        </div>
                    </div>
                </article>
            </div>
        {% else %}
            <div class="col-12">
                <div class="card shadow-sm"><div class="card-body text-body-secondary">Aucun casier correspondant à votre filtre.</div></div>
            </div>
        {% endfor %}
    </section>

    {% if not is_granted('ROLE_ADMIN') %}
        {% set durationsBody %}
            <form id="durationsForm" method="post" action="{{ path('app_admin_locker_bays_update_durations', {id: bay.id}) }}" class="row g-3">
                <input type="hidden" name="_token" value="{{ csrf_token('update_durations_' ~ bay.id) }}">
                <div class="col-12 col-md-6">
                    <label for="minDurationInput" class="form-label">Durée min (minutes)</label>
                    <input id="minDurationInput" type="number" name="minDuration" min="0" class="form-control" value="{{ bay.minDuration }}">
                </div>
                <div class="col-12 col-md-6">
                    <label for="maxDurationInput" class="form-label">Durée max (minutes)</label>
                    <input id="maxDurationInput" type="number" name="maxDuration" min="0" class="form-control" value="{{ bay.maxDuration }}">
                </div>
            </form>
        {% endset %}

        {% set durationsFooter %}
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
            <button type="submit" class="btn btn-primary" form="durationsForm">Enregistrer</button>
        {% endset %}

        {{ modal.base('durationsModal', 'Modifier les durées de la baie', durationsBody, durationsFooter) }}

        {% set overtimeSurchargeBody %}
            <form id="overtimeSurchargeForm" method="post" action="{{ path('app_admin_locker_bays_update_overtime_surcharge', {id: bay.id}) }}" class="row g-3">
                <input type="hidden" name="_token" value="{{ csrf_token('update_overtime_surcharge_' ~ bay.id) }}">
                <div class="col-12">
                    <label for="overtimeSurchargeInput" class="form-label">Majoration dépassement (%)</label>
                    <input id="overtimeSurchargeInput" type="number" name="overtimeSurchargePercent" min="0" class="form-control" value="{{ bay.overtimeSurchargePercent }}">
                    <div class="form-text">Pourcentage appliqué au surcoût de dépassement.</div>
                </div>
            </form>
        {% endset %}

        {% set overtimeSurchargeFooter %}
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
            <button type="submit" class="btn btn-primary" form="overtimeSurchargeForm">Enregistrer</button>
        {% endset %}

        {{ modal.base('overtimeSurchargeModal', 'Modifier la majoration de dépassement', overtimeSurchargeBody, overtimeSurchargeFooter) }}

        {% for locker in lockers %}
            {% set lockerPriceBody %}
                <form id="lockerPriceForm{{ locker.id }}" method="post" action="{{ path('app_admin_lockers_update_price', {id: locker.id}) }}" class="row g-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('update_price_' ~ locker.id) }}">
                    <div class="col-12">
                        <label for="lockerPriceInput{{ locker.id }}" class="form-label">Prix (EUR)</label>
                        <input id="lockerPriceInput{{ locker.id }}" type="text" name="priceEuro" class="form-control" value="{{ (locker.priceCents / 100)|number_format(2, ',', '') }}" placeholder="0,00">
                        <div class="form-text">Saisir en euros (ex: 3,50). Conversion automatique en centimes.</div>
                    </div>
                </form>
            {% endset %}

            {% set lockerPriceFooter %}
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary" form="lockerPriceForm{{ locker.id }}">Enregistrer</button>
            {% endset %}

            {{ modal.base('lockerPriceModal' ~ locker.id, 'Modifier le prix du casier #' ~ locker.number, lockerPriceBody, lockerPriceFooter) }}
        {% endfor %}
    {% endif %}
{% endblock %}
