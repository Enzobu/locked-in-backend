{% extends 'admin/layout.html.twig' %}
{% import 'macros/badge.html.twig' as label %}
{% import 'macros/modal.html.twig' as modal %}

{% block title %}Casier #{{ locker.number }}{% endblock %}

{% block admin_content %}
    <section class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
        <div>
            <a class="link-secondary text-decoration-none" href="{{ path('app_admin_locker_bays_show', {id: locker.lockerBay.id}) }}">← Retour à la baie {{ locker.lockerBay.name }}</a>
            <h2 class="h3 mt-2 mb-1">Casier #{{ locker.number }}</h2>
            <p class="text-body-secondary mb-0">{{ locker.lockerBay.name }} - {{ locker.lockerBay.company.name }}</p>
        </div>
        {% if not is_granted('ROLE_ADMIN') %}
            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#lockerPriceModal{{ locker.id }}">Modifier prix</button>
        {% endif %}
        {% if is_granted('ROLE_ADMIN') %}
            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary" href="{{ path('app_admin_companies_lockers_edit', {id: locker.id}) }}">Modifier casier</a>
                <form id="deleteLockerForm{{ locker.id }}" method="post" action="{{ path('app_admin_companies_lockers_delete', {id: locker.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_locker_' ~ locker.id) }}">
                    <button class="btn btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteLockerModal{{ locker.id }}">Supprimer casier</button>
                </form>
                {{ modal.confirm('deleteLockerModal' ~ locker.id, 'Supprimer un casier', 'Voulez-vous vraiment supprimer ce casier ?', 'deleteLockerForm' ~ locker.id, 'Supprimer', 'danger') }}
            </div>
        {% endif %}
    </section>

    <section class="row g-3 mb-4">
        <div class="col-12 col-xl-4">
            <article class="card shadow-sm h-100">
                <div class="card-header bg-transparent"><h3 class="h6 mb-0">Informations casier</h3></div>
                <div class="card-body small">
                    <p class="mb-2"><strong>Statut:</strong>
                        {% if locker.status.value == 'available' %}
                            {{ label.default('Disponible', 'success') }}
                        {% elseif locker.status.value == 'reserved' %}
                            {{ label.default('Réservé') }}
                        {% elseif locker.status.value == 'occupied' %}
                            {{ label.default('Occupé', 'warning') }}
                        {% elseif locker.status.value == 'offline' %}
                            {{ label.default('Offline', 'danger') }}
                        {% else %}
                            {{ label.default('Hors service', 'dark') }}
                        {% endif %}
                    </p>
                    <p class="mb-2"><strong>Hardware ID:</strong> {{ locker.hardwareId ?? '-' }}</p>
                    <p class="mb-2"><strong>Prix:</strong> {{ (locker.priceCents / 100)|number_format(2, ',', ' ') }} EUR</p>
                    <p class="mb-2"><strong>Derniere vue:</strong> {{ locker.lastSeenAt ? locker.lastSeenAt|date('d/m/Y H:i') : '-' }}</p>
                    <p class="mb-0"><strong>Derniere maj:</strong> {{ locker.updatedAt|date('d/m/Y H:i') }}</p>
                </div>
            </article>
        </div>
        <div class="col-12 col-xl-8">
            <article class="card shadow-sm h-100">
                <div class="card-header bg-transparent"><h3 class="h6 mb-0">Mini dashboard</h3></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6 col-lg-4">{{ label.emphasis(upcomingReservations|length ~ ' à venir', 'primary') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(currentReservations|length ~ ' en cours', 'success') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(historyReservations|length ~ ' historiques', 'secondary') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(recentActions|length ~ ' actions', 'warning') }}</div>
                        <div class="col-6 col-lg-4">{{ label.emphasis(recentEvents|length ~ ' événements', 'info') }}</div>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <section class="row g-3 mb-4">
        <div class="col-12">
            <article class="card shadow-sm">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h3 class="h6 mb-0">Réservations à venir</h3>
                    {{ label.default(upcomingReservations|length, 'primary') }}
                </div>
                <div class="card-body p-0">
                    {% if upcomingReservations is empty %}
                        <p class="p-3 text-body-secondary mb-0">Aucune réservation à venir.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead><tr><th>Début</th><th>Fin</th><th>Client</th><th>Statut</th></tr></thead>
                                <tbody>
                                    {% for reservation in upcomingReservations %}
                                        <tr>
                                            <td>{{ reservation.startsAt|date('d/m/Y H:i') }}</td>
                                            <td>{{ reservation.endsAt|date('d/m/Y H:i') }}</td>
                                            <td>{{ reservation.customer.firstname }} {{ reservation.customer.lastname }}</td>
                                            <td>{{ label.default(reservation.status.value, 'secondary') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </article>
        </div>
    </section>

    <section class="row g-3 mb-4">
        <div class="col-12">
            <article class="card shadow-sm">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h3 class="h6 mb-0">Réservation(s) en cours</h3>
                    {{ label.default(currentReservations|length, 'success') }}
                </div>
                <div class="card-body p-0">
                    {% if currentReservations is empty %}
                        <p class="p-3 text-body-secondary mb-0">Aucune reservation en cours.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead><tr><th>Début</th><th>Fin</th><th>Client</th><th>Statut</th></tr></thead>
                                <tbody>
                                    {% for reservation in currentReservations %}
                                        <tr>
                                            <td>{{ reservation.startsAt|date('d/m/Y H:i') }}</td>
                                            <td>{{ reservation.endsAt|date('d/m/Y H:i') }}</td>
                                            <td>{{ reservation.customer.firstname }} {{ reservation.customer.lastname }}</td>
                                            <td>{{ label.default(reservation.status.value, 'success') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </article>
        </div>
    </section>

    <section class="row g-3">
        <div class="col-12">
            <article class="card shadow-sm">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h3 class="h6 mb-0">Historique des réservations</h3>
                    {{ label.default(historyReservations|length, 'secondary') }}
                </div>
                <div class="card-body p-0">
                    {% if historyReservations is empty %}
                        <p class="p-3 text-body-secondary mb-0">Aucun historique de réservation.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead><tr><th>Début</th><th>Fin</th><th>Client</th><th>Statut</th></tr></thead>
                                <tbody>
                                    {% for reservation in historyReservations %}
                                        <tr>
                                            <td>{{ reservation.startsAt|date('d/m/Y H:i') }}</td>
                                            <td>{{ reservation.endsAt|date('d/m/Y H:i') }}</td>
                                            <td>{{ reservation.customer.firstname }} {{ reservation.customer.lastname }}</td>
                                            <td>{{ label.default(reservation.status.value, 'secondary') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </article>
        </div>
    </section>

    {% if not is_granted('ROLE_ADMIN') %}
        {% set lockerPriceBody %}
            <form id="lockerPriceForm{{ locker.id }}" method="post" action="{{ path('app_admin_lockers_update_price', {id: locker.id}) }}" class="row g-3">
                <input type="hidden" name="_token" value="{{ csrf_token('update_price_' ~ locker.id) }}">
                <div class="col-12">
                    <label for="lockerPriceInput{{ locker.id }}" class="form-label">Prix (EUR)</label>
                    <input id="lockerPriceInput{{ locker.id }}" type="text" name="priceEuro" class="form-control" value="{{ (locker.priceCents / 100)|number_format(2, ',', '') }}" placeholder="0,00">
                    <div class="form-text">Saisir en euros (ex: 3,50). Conversion automatique en centimes.</div>
                </div>
            </form>
        {% endset %}

        {% set lockerPriceFooter %}
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
            <button type="submit" class="btn btn-primary" form="lockerPriceForm{{ locker.id }}">Enregistrer</button>
        {% endset %}

        {{ modal.base('lockerPriceModal' ~ locker.id, 'Modifier le prix du casier #' ~ locker.number, lockerPriceBody, lockerPriceFooter) }}
    {% endif %}
{% endblock %}
