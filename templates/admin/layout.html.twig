{% extends 'base.html.twig' %}

{% block body_class %}admin-body{% endblock %}

{% block body %}
    <div class="container-fluid admin-shell px-0">
        <div class="row g-0">
            <aside class="col-xl-2 col-lg-3 d-none d-lg-flex flex-column border-end bg-body-tertiary admin-sidebar">
                <div class="admin-sidebar-brand border-bottom">
                    <p class="text-uppercase text-body-secondary fw-semibold small mb-1">Open Innov</p>
                    <h1 class="h5 mb-0">Backoffice</h1>
                </div>

                <nav class="admin-nav flex-grow-1">
                    {% include 'admin/_nav_items.html.twig' %}
                </nav>

                <div class="admin-sidebar-footer border-top">
                    <p class="small text-body-secondary mb-1">Connecté en tant que</p>
                    <p class="fw-semibold mb-3 text-truncate">{{ app.user ? app.user.userIdentifier : 'Utilisateur' }}</p>
                    <a href="{{ path('app_admin_logout') }}" class="btn btn-outline-danger w-100 btn-sm">Se déconnecter</a>
                </div>
            </aside>

            <div class="col-xl-10 col-lg-9 admin-main-column">
                <header class="border-bottom bg-body z-2 flex-shrink-0 admin-topbar">
                    <div class="d-flex align-items-center justify-content-between px-3 py-3 px-lg-4">
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar">
                                Menu
                            </button>
                            <div>
                                <p class="text-uppercase text-body-secondary fw-semibold small mb-1">{{ block('admin_page_kicker') }}</p>
                                <p class="mb-0 fw-semibold">{{ block('admin_page_title') }}</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            {% block admin_topbar_actions %}{% endblock %}
                            <a href="{{ path('app_admin_logout') }}" class="btn btn-outline-danger btn-sm d-lg-none">Se déconnecter</a>
                        </div>
                    </div>
                </header>

                <main class="p-3 p-lg-4 admin-content-scroll mb-2">
                    {% for type, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block admin_content %}{% endblock %}
                </main>
            </div>
        </div>
    </div>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
        <div class="offcanvas-header border-bottom admin-sidebar-brand">
            <div>
                <p class="text-uppercase text-body-secondary fw-semibold small mb-1">Open Innov</p>
                <h2 class="h5 mb-0" id="adminSidebarLabel">Backoffice</h2>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0 admin-nav">
            {% include 'admin/_nav_items.html.twig' %}
        </div>
    </div>
{% endblock %}

{% block admin_page_kicker %}Administration{% endblock %}
{% block admin_page_title %}
    {% set route = app.request.attributes.get('_route') %}
    {% if route starts with 'app_admin_dashboard' %}
        Tableau de bord
    {% elseif route starts with 'app_admin_locker_bays' or route starts with 'app_admin_lockers' %}
        Casiers
    {% elseif route starts with 'app_admin_companies' %}
        Sociétés
    {% elseif route starts with 'app_admin_users' %}
        Utilisateurs BO
    {% elseif route starts with 'app_admin_customers' %}
        Clients
    {% else %}
        Backoffice
    {% endif %}
{% endblock %}
