{% extends 'admin/layout.html.twig' %}

{% block title %}Clients{% endblock %}

{% block admin_content %}
    <section class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
        <div>
            <h2 class="h3 mb-1">Clients</h2>
            <p class="text-body-secondary mb-0">Gestion des comptes clients de l'application mobile.</p>
        </div>
        <a href="{{ path('app_admin_customers_new') }}" class="btn btn-primary">Nouveau client</a>
    </section>

    <form class="row g-2 mb-3" method="get">
        <div class="col-12 col-md-6 col-xl-4">
            <input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Rechercher email, nom, ville">
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary" type="submit">Rechercher</button>
        </div>
        <div class="col-auto">
            <a class="btn btn-outline-secondary" href="{{ path('app_admin_customers_index', {'deleted': showDeleted ? 0 : 1}) }}">
                {{ showDeleted ? 'Voir actifs' : 'Voir supprimés' }}
            </a>
        </div>
    </form>

    <article class="card shadow-sm">
        <div class="card-body p-0">
            {% if customers is empty %}
                <p class="p-3 text-body-secondary mb-0">Aucun client trouvé.</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Email</th>
                                <th>Date de naissance</th>
                                <th>Adresse</th>
                                <th>Créé le</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for customer in customers %}
                                <tr>
                                    {% set primaryAddress = customer.primaryAddress %}
                                    <td>{{ customer.firstname }} {{ customer.lastname }}</td>
                                    <td>{{ customer.email }}</td>
                                    <td>{{ customer.birthDate|date('d/m/Y') }}</td>
                                    <td>
                                        {% if primaryAddress %}
                                            {{ primaryAddress.number }} {{ primaryAddress.street }}, {{ primaryAddress.city }}
                                        {% else %}
                                            <span class="text-body-secondary">Aucune adresse</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ customer.createdAt|date('d/m/Y H:i') }}</td>
                                    <td class="text-end">
                                        {% if showDeleted %}
                                            <form method="post" action="{{ path('app_admin_customers_restore', {'id': customer.id}) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('restore_customer_' ~ customer.id) }}">
                                                <button class="btn btn-sm btn-outline-success" type="submit">Restaurer</button>
                                            </form>
                                        {% else %}
                                            <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_customers_edit', {'id': customer.id}) }}">Modifier</a>
                                            <form method="post" action="{{ path('app_admin_customers_delete', {'id': customer.id}) }}" class="d-inline" onsubmit="return confirm('Désactiver ce client ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_customer_' ~ customer.id) }}">
                                                <button class="btn btn-sm btn-outline-danger" type="submit">Désactiver</button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </article>
{% endblock %}
