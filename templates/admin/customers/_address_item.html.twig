<div class="border rounded p-3 mb-2">
    <div class="row g-3">
        <div class="col-12 col-md-4">{{ form_row(addressForm.number) }}</div>
        <div class="col-12 col-md-8">{{ form_row(addressForm.street) }}</div>
        <div class="col-12 col-md-6">{{ form_row(addressForm.city) }}</div>
        <div class="col-12 col-md-6">{{ form_row(addressForm.country) }}</div>
        <div class="col-12">{{ form_row(addressForm.complement) }}</div>
        <div class="col-12 d-flex justify-content-end" data-form-collection-actions></div>
    </div>
</div>
