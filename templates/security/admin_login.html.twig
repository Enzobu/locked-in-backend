{% extends 'base.html.twig' %}

{% block title %}Connexion Backoffice{% endblock %}

{% block body %}
    <main style="max-width: 420px; margin: 4rem auto; font-family: sans-serif;">
        <h1 style="margin-bottom: 1.5rem;">Connexion Backoffice</h1>

        {% if error %}
            <div style="margin-bottom: 1rem; color: #b00020;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post">
            <div style="display: grid; gap: 0.5rem; margin-bottom: 1rem;">
                <label for="username">Email</label>
                <input id="username" type="email" name="_username" value="{{ last_username }}" required autofocus>
            </div>

            <div style="display: grid; gap: 0.5rem; margin-bottom: 1.5rem;">
                <label for="password">Mot de passe</label>
                <input id="password" type="password" name="_password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Se connecter</button>
        </form>
    </main>
{% endblock %}
