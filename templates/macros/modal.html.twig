{% macro base(id, title, body, footer, size = '') %}
    <div class="modal fade" id="{{ id }}" tabindex="-1" aria-labelledby="{{ id }}Label" aria-hidden="true">
        <div class="modal-dialog {{ size }}">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="{{ id }}Label">{{ title }}</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {{ body|raw }}
                </div>
                <div class="modal-footer">
                    {{ footer|raw }}
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro confirm(id, title, message, formId, confirmLabel = 'Confirmer', confirmVariant = 'danger') %}
    {% set body %}
        <p class="mb-0">{{ message }}</p>
    {% endset %}

    {% set footer %}
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
        <button type="submit" class="btn btn-{{ confirmVariant }}" form="{{ formId }}">{{ confirmLabel }}</button>
    {% endset %}

    {{ _self.base(id, title, body, footer) }}
{% endmacro %}
